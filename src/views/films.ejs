<%- include('partials/header.ejs') %>

<h2> Liste de films disponibles </h2>


    <div class="film-grid">
        <% films.forEach((film) => { %>
      <div class="film-card"><h3>Titre: <%= film.titre %> </h3>
        <p>Année: <%= film.annee_sortie %> </p>
        <p>Réalisateur: <%= film.realisateur %> </p>
        <p>Stock: <%= film.quantite_stock %> </p>
      </div>
            <% }); %>
    </div>



<%- include('partials/footer.ejs') %>