<%- include('partials/header') %>

<div class="form-container">
   <form method="POST" action="/reservations/nouvelle">

       <div class="form-group">
         <label for="adherent">Adherent</label>
         <select name="adherent_id" id="adherent" required>
             <option value="">Choisir un adherent</option>
             <% adherents.forEach( (adherent) => { %>
               <option value="<%= adherent.id %>">
                 <%= adherent.prenom %> <%= adherent.nom %>
               </option>
             <% }) %>
         </select>
       </div>

       <div class="form-group">
         <label for="film">Film</label>
         <select name="film_id" id="film" required>
             <option value="">Choisir un film</option>
             <% films.forEach( (film) => { %>
                 <option value="<%= film.id %>">
                     <%= film.titre %>
                 </option>
             <% }) %>
         </select>
       </div>

       <button type="submit" class="btn-primary">Enregistrer la reservation</button>
       <a href="/reservations" class="btn-secondary">retour à la la liste des reservations</a>
   </form>
</div>



<%- include('partials/footer') %>